{
  "name": "backend-esms",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prisma:prep": "node scripts/sync-prisma-provider.cjs",
    "dev": "npm run db:push && tsx watch src/server.ts",
    "postinstall": "npm run db:generate",
    "build": "npm run db:generate && tsc",
    "start": "npm run db:generate && npm run db:push && node dist/server.js",
    "test": "vitest run",
    "db:generate": "npm run prisma:prep && prisma generate --schema=prisma/schema.runtime.prisma",
    "db:push": "npm run prisma:prep && prisma db push --schema=prisma/schema.runtime.prisma",
    "db:migrate": "npm run db:push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "npm run prisma:prep && prisma studio --schema=prisma/schema.runtime.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "prisma": "^6.19.3",
    "shared-types": "*",
    "zod": "^3.23.8"
  }
}
